{
	"compilerOptions": {
		"target": "es2020",
		"module": "commonjs",
		"moduleResolution": "node",
		"rootDir": "src",
		"outDir": "dist",

		"baseUrl": "src",
		"paths": {
			"@/*": ["*"]
		},

		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,

		"strict": true,
		"noImplicitReturns": true,
		"forceConsistentCasingInFileNames": true,

		"skipLibCheck": true,

		"ignoreDeprecations": "6.0"
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
